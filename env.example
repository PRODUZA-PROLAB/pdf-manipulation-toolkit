# pdf-manipulation-toolkit — variáveis de ambiente (EXEMPLO)
# ------------------------------------------------------------
# Nenhuma variável é obrigatória para o runtime desta biblioteca.
# Copie este arquivo para .env SOMENTE se precisar customizar algo.
# NUNCA commite um arquivo .env real — o .gitignore já o bloqueia.

# Limite opcional de páginas para operações de merge/split (não aplicado por padrão)
PDF_TOOLKIT_MAX_PAGES=1000

# Habilitar logs de debug (true/false)
PDF_TOOLKIT_DEBUG=false
